<Page x:Class="ZenFlow.Views.VistaHabitos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Hábitos" Background="#0D0D0D">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mis hábitos" FontSize="20"
                   FontWeight="Medium" Foreground="#FFFFFF"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#141414" CornerRadius="8"
                BorderBrush="#222222" BorderThickness="1"
                Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtHabito" Grid.Column="0"
                         Height="36" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="+ Agregar"
                        Height="36" Padding="16,0"
                        FontSize="13" FontWeight="Medium"
                        Background="#FFFFFF" Foreground="#000000"
                        BorderThickness="0" Cursor="Hand"
                        Click="AgregarHabito_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#DDDDDD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaHabitos">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#141414" CornerRadius="8"
                                BorderBrush="#222222" BorderThickness="1"
                                Margin="0,0,0,8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Nombre}"
                                               FontSize="13" Foreground="#DDDDDD"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,3,0,0">
                                        <TextBlock Text="🔥 " FontSize="11"/>
                                        <TextBlock Text="{Binding RachaDias, StringFormat='{}{0} días seguidos'}"
                                                   FontSize="11" Foreground="#2A6A2A"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✓ Cumplí hoy"
                                        Height="30" Padding="10,0" Margin="8,0"
                                        FontSize="12" Cursor="Hand"
                                        Background="#0A1A0A" Foreground="#2A8A2A"
                                        BorderThickness="0"
                                        Tag="{Binding Id}"
                                        Click="Cumplir_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2" Content="🗑"
                                        Width="30" Height="30"
                                        FontSize="13" Cursor="Hand"
                                        Background="#1A0A0A" Foreground="#662222"
                                        BorderThickness="0"
                                        Tag="{Binding Id}"
                                        Click="Eliminar_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>