<Page x:Class="ZenFlow.Views.VistaApps"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Apps" Background="#F5F7FA">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Apps a bloquear" FontSize="24"
                       FontWeight="Bold" Foreground="#1F4E79"/>
            <TextBlock Text="Activa las que quieres bloquear durante el modo enfoque"
                       FontSize="12" Foreground="#888" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- AGREGAR APP -->
        <Border Grid.Row="1" Background="White" CornerRadius="10"
                Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Agregar nueva app" FontSize="13"
                           FontWeight="SemiBold" Foreground="#1F4E79"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNombre" Grid.Column="0"
                             Height="36" Padding="10,8" FontSize="13"
                             Margin="0,0,10,0" BorderBrush="#DDDDDD"
                             BorderThickness="1" Background="#FAFAFA"
                             Tag="Nombre visible (ej: Spotify)"/>
                    <TextBox x:Name="TxtProceso" Grid.Column="1"
                             Height="36" Padding="10,8" FontSize="13"
                             Margin="0,0,10,0" BorderBrush="#DDDDDD"
                             BorderThickness="1" Background="#FAFAFA"
                             Tag="Nombre del proceso (ej: Spotify)"/>
                    <Button Grid.Column="2" Content="+ Agregar"
                            Height="36" Padding="16,0" FontSize="13"
                            Cursor="Hand" BorderThickness="0"
                            Click="Agregar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1F4E79"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#185FA5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <TextBlock FontSize="11" Foreground="#888" Margin="0,8,0,0"
                           Text="💡 El nombre del proceso es el que aparece en el Administrador de tareas → columna 'Nombre'"/>
            </StackPanel>
        </Border>

        <!-- LISTA DE APPS -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaApps">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8"
                                Margin="0,0,0,10" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Toggle activa/desactiva -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Activa}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          Tag="{Binding Id}"
                                          Click="Toggle_Click"/>

                                <!-- Info de la app -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nombre}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#222"/>
                                    <TextBlock FontSize="11" Foreground="#888"
                                               Margin="0,2,0,0">
                                        <Run Text="Proceso: "/>
                                        <Run Text="{Binding Proceso}"
                                             FontFamily="Courier New"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Badge activa/inactiva -->
                                <Border Grid.Column="2" CornerRadius="20"
                                        Padding="10,4" Margin="8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FCEBEB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Activa}" Value="True">
                                                    <Setter Property="Background" Value="#E1F5EE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Inactiva"/>
                                                <Setter Property="Foreground" Value="#A32D2D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activa}" Value="True">
                                                        <Setter Property="Text" Value="Activa"/>
                                                        <Setter Property="Foreground" Value="#0F6E56"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Botón eliminar -->
                                <Button Grid.Column="3" Content="🗑"
                                        Width="36" Height="36"
                                        FontSize="14" Cursor="Hand"
                                        BorderThickness="0"
                                        Tag="{Binding Id}"
                                        Click="Eliminar_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FCEBEB"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5C6C6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>