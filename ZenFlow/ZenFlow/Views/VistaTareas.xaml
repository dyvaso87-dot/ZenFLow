<Page x:Class="ZenFlow.Views.VistaTareas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Tareas" Background="#0D0D0D">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Mis tareas" FontSize="20" FontWeight="Medium"
                       Foreground="#FFFFFF"/>
            <TextBlock x:Name="TxtFecha" FontSize="12"
                       Foreground="#444444" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtTitulo" Grid.Column="0"
                     Height="38" Margin="0,0,8,0"/>
            <DatePicker x:Name="DpFecha" Grid.Column="1"
                        Height="38" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="+ Agregar"
                    Height="38" Padding="16,0"
                    FontSize="13" FontWeight="Medium"
                    Background="#FFFFFF" Foreground="#000000"
                    BorderThickness="0" Cursor="Hand"
                    Click="AgregarTarea_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDDDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaTareas">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#141414"
                                BorderBrush="#222222"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,8"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Titulo}"
                                               FontSize="13" Foreground="#DDDDDD"/>
                                    <TextBlock Text="{Binding FechaLimite, StringFormat='Vence: {0:dd/MM/yyyy}'}"
                                               FontSize="11" Foreground="#444444"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✓ Completar"
                                        Height="30" Padding="10,0" Margin="8,0"
                                        FontSize="12" Cursor="Hand"
                                        Background="#0A1A0A" Foreground="#2A8A2A"
                                        BorderThickness="0"
                                        Tag="{Binding Id}"
                                        Click="Completar_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2" Content="🗑 Eliminar"
                                        Height="30" Padding="10,0"
                                        FontSize="12" Cursor="Hand"
                                        Background="#1A0A0A" Foreground="#662222"
                                        BorderThickness="0"
                                        Tag="{Binding Id}"
                                        Click="Eliminar_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>