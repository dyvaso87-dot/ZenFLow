<Page x:Class="ZenFlow.Views.VistaEnfoque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Enfoque" Background="#0D0D0D">
    <Page.Resources>
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WhiteBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DDDDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0D0D0D">
        <Grid Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: TIMER -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Text="Modo Enfoque" FontSize="20" FontWeight="Medium"
                           Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock Text="Configura tu sesión y bloquea lo que te distrae"
                           FontSize="12" Foreground="#444444" Margin="0,0,0,24"/>

                <Border Background="#141414" CornerRadius="12"
                        BorderBrush="#222222" BorderThickness="1"
                        Padding="32">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Círculo timer -->
                        <Border Width="200" Height="200" CornerRadius="100"
                                BorderBrush="#222222" BorderThickness="6"
                                Margin="0,0,0,24">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtTimer" Text="25:00"
                                           FontSize="48" FontWeight="Medium"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtEstado" Text="Listo"
                                           FontSize="13" Foreground="#444444"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Duración -->
                        <TextBlock Text="Duración (minutos)" FontSize="12"
                                   Foreground="#555555" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Content="−" Width="36" Height="36"
                                    FontSize="18" Style="{StaticResource DarkBtn}"
                                    Click="Menos_Click"/>
                            <TextBox x:Name="TxtMinutos" Text="25"
                                     Width="70" Height="36"
                                     FontSize="18" FontWeight="Medium"
                                     Foreground="#FFFFFF"
                                     TextAlignment="Center"
                                     Margin="8,0"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource DarkInput}"/>
                            <Button Content="+" Width="36" Height="36"
                                    FontSize="18" Style="{StaticResource DarkBtn}"
                                    Click="Mas_Click"/>
                        </StackPanel>

                        <!-- Presets -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Button Content="5 min"  Tag="5"  Click="Preset_Click"
                                    Margin="4,0" Style="{StaticResource PresetBtn}"/>
                            <Button Content="15 min" Tag="15" Click="Preset_Click"
                                    Margin="4,0" Style="{StaticResource PresetBtn}"/>
                            <Button Content="25 min" Tag="25" Click="Preset_Click"
                                    Margin="4,0" Style="{StaticResource PresetBtn}"/>
                            <Button Content="50 min" Tag="50" Click="Preset_Click"
                                    Margin="4,0" Style="{StaticResource PresetBtn}"/>
                        </StackPanel>

                        <!-- Botones control -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="BtnIniciar" Content="▶  Iniciar"
                                    Height="40" Padding="24,0" Margin="0,0,10,0"
                                    FontSize="13" Style="{StaticResource WhiteBtn}"
                                    Click="Iniciar_Click"/>
                            <Button Content="⏸  Pausar" Height="40" Padding="16,0"
                                    Margin="0,0,10,0" FontSize="13"
                                    Style="{StaticResource DarkBtn}"
                                    Click="Pausar_Click"/>
                            <Button Content="⏹  Terminar" Height="40" Padding="16,0"
                                    FontSize="13" Background="#1A0A0A"
                                    Foreground="#662222" BorderBrush="#2A1010"
                                    BorderThickness="1" Cursor="Hand"
                                    Click="Terminar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- COLUMNA DERECHA: APPS -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Apps a bloquear" FontSize="16" FontWeight="Medium"
                           Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock Text="Activa o desactiva durante la sesión"
                           FontSize="11" Foreground="#444444"
                           Margin="0,0,0,16" TextWrapping="Wrap"/>

                <!-- Lista -->
                <Border Background="#141414" CornerRadius="10"
                        BorderBrush="#222222" BorderThickness="1"
                        Padding="12" Margin="0,0,0,12">
                    <ScrollViewer MaxHeight="260"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaApps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding Activa}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Tag="{Binding Id}"
                                                  Click="Toggle_Click"/>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontSize="13"
                                                       Foreground="#DDDDDD"/>
                                            <TextBlock Text="{Binding Proceso}"
                                                       FontSize="10"
                                                       Foreground="#444444"
                                                       FontFamily="Courier New"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🗑"
                                                Width="28" Height="28"
                                                FontSize="12" Cursor="Hand"
                                                Background="#1A0A0A"
                                                Foreground="#662222"
                                                BorderThickness="0"
                                                Tag="{Binding Id}"
                                                Click="EliminarApp_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Agregar app -->
                <Border Background="#141414" CornerRadius="10"
                        BorderBrush="#222222" BorderThickness="1"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Agregar app" FontSize="12"
                                   FontWeight="Medium" Foreground="#AAAAAA"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtNombreApp" Height="32"
                                 Margin="0,0,0,6"
                                 Style="{StaticResource DarkInput}"/>
                        <TextBox x:Name="TxtProcesoApp" Height="32"
                                 Margin="0,0,0,8"
                                 Style="{StaticResource DarkInput}"/>
                        <TextBlock Text="💡 Ve al Administrador de tareas → Detalles"
                                   FontSize="10" Foreground="#444444"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="+ Agregar" Height="32" FontSize="12"
                                Style="{StaticResource WhiteBtn}"
                                Click="AgregarApp_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>