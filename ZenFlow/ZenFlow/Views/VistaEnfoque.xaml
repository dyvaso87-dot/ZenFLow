<Page x:Class="ZenFlow.Views.VistaEnfoque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Enfoque" Background="#F5F7FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: TIMER -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Text="Modo Enfoque" FontSize="24" FontWeight="Bold"
                           Foreground="#1F4E79" Margin="0,0,0,6"/>
                <TextBlock Text="Configura tu sesión y bloquea lo que te distrae"
                           FontSize="12" Foreground="#888" Margin="0,0,0,24"/>

                <Border Background="White" CornerRadius="12" Padding="32">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Círculo timer -->
                        <Border Width="200" Height="200" CornerRadius="100"
                                BorderBrush="#E6F1FB" BorderThickness="8"
                                Margin="0,0,0,24">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtTimer" Text="25:00"
                                           FontSize="48" FontWeight="Bold"
                                           Foreground="#1F4E79"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtEstado" Text="Listo"
                                           FontSize="13" Foreground="#888"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Duración -->
                        <TextBlock Text="Duración (minutos)" FontSize="12"
                                   Foreground="#555" HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Content="−" Width="36" Height="36" FontSize="18"
                                    Cursor="Hand" BorderThickness="1"
                                    BorderBrush="#DDDDDD" Background="White"
                                    Click="Menos_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBox x:Name="TxtMinutos" Text="25" Width="70"
                                     Height="36" FontSize="18" FontWeight="Bold"
                                     Foreground="#1F4E79" TextAlignment="Center"
                                     BorderBrush="#DDDDDD" Margin="8,0"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="+" Width="36" Height="36" FontSize="18"
                                    Cursor="Hand" BorderThickness="1"
                                    BorderBrush="#DDDDDD" Background="White"
                                    Click="Mas_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Presets -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Button Content="5 min"  Tag="5"  Click="Preset_Click" Margin="4,0" Padding="10,5" FontSize="11" Cursor="Hand" BorderThickness="1" BorderBrush="#DDDDDD" Background="#F5F5F5">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E6F1FB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="15 min" Tag="15" Click="Preset_Click" Margin="4,0" Padding="10,5" FontSize="11" Cursor="Hand" BorderThickness="1" BorderBrush="#DDDDDD" Background="#F5F5F5">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E6F1FB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="25 min" Tag="25" Click="Preset_Click" Margin="4,0" Padding="10,5" FontSize="11" Cursor="Hand" BorderThickness="1" BorderBrush="#DDDDDD" Background="#F5F5F5">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E6F1FB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="50 min" Tag="50" Click="Preset_Click" Margin="4,0" Padding="10,5" FontSize="11" Cursor="Hand" BorderThickness="1" BorderBrush="#DDDDDD" Background="#F5F5F5">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E6F1FB"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Botones control -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnIniciar" Content="▶  Iniciar"
                                    Height="40" Padding="24,0" Margin="0,0,10,0"
                                    FontSize="13" Cursor="Hand" BorderThickness="0"
                                    Click="Iniciar_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#1F4E79"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#185FA5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="⏸  Pausar" Height="40" Padding="16,0"
                                    Margin="0,0,10,0" FontSize="13" Cursor="Hand"
                                    BorderThickness="1" BorderBrush="#DDDDDD"
                                    Background="White" Click="Pausar_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="⏹  Terminar" Height="40" Padding="16,0"
                                    FontSize="13" Cursor="Hand"
                                    Background="#FCEBEB" Foreground="#A32D2D"
                                    BorderThickness="0" Click="Terminar_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5C6C6"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- COLUMNA DERECHA: APPS A BLOQUEAR -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Apps a bloquear" FontSize="16" FontWeight="Bold"
                           Foreground="#1F4E79" Margin="0,0,0,6"/>
                <TextBlock Text="Activa o desactiva durante la sesión"
                           FontSize="11" Foreground="#888" Margin="0,0,0,16"
                           TextWrapping="Wrap"/>

                <!-- Lista de apps guardadas -->
                <Border Background="White" CornerRadius="10" Padding="12"
                        Margin="0,0,0,12">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaApps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding Activa}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Tag="{Binding Id}"
                                                  Click="Toggle_Click"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#222"/>
                                            <TextBlock FontSize="10" Foreground="#888">
                                                <Run Text="{Binding Proceso}"
                                                     FontFamily="Courier New"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="🗑"
                                                Width="30" Height="30" FontSize="12"
                                                Cursor="Hand" BorderThickness="0"
                                                Background="#FCEBEB"
                                                Tag="{Binding Id}"
                                                Click="EliminarApp_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F5C6C6"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Agregar nueva app -->
                <Border Background="White" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Agregar app" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#1F4E79"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtNombreApp" Height="32"
                                 Padding="8,6" FontSize="12"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 Background="#FAFAFA" Margin="0,0,0,6"
                                 Tag="Nombre visible (ej: Opera GX)"/>
                        <TextBox x:Name="TxtProcesoApp" Height="32"
                                 Padding="8,6" FontSize="12"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 Background="#FAFAFA" Margin="0,0,0,8"
                                 Tag="Proceso exacto (ej: opera)"/>
                        <TextBlock Text="💡 Ve al Administrador de tareas → Detalles para ver el nombre exacto del proceso"
                                   FontSize="10" Foreground="#888"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="+ Agregar" Height="32" FontSize="12"
                                Cursor="Hand" BorderThickness="0"
                                Click="AgregarApp_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1F4E79"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#185FA5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>